{
  "manifest_version": 3,
  "name": "Open Multiple Queries/Searches",
  "version": "1.0.0",
  "description": "Easily open a list of text queries as multiple searches in new tabs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Queries"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "search",
    "tabs"
  ]
}
